# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git. Never commit real values.

# Your Oncade TEST API key (starts with oncade_platform_test_)
ONCADE_API_KEY=

# The business the invoices are issued for (the "businessId" from GET /v1/platform/me)
ONCADE_BUSINESS_ID=

# Webhook secret from the developer portal: your platform > Settings
ONCADE_WEBHOOK_SECRET=
